# Fleet configuration — copy to ~/.claude-mem/.env-fleet and fill in values
# chmod 600 ~/.claude-mem/.env-fleet

# Hosts (private LAN IPs)
FLEET_BOT_HOST=""
FLEET_PROD_HOST=""
FLEET_WIN_HOST=""

# SSH
FLEET_USER=""
FLEET_WIN_USER=""
FLEET_SSH_KEY="$HOME/.ssh/id_rsa"

# Notifications (ntfy.sh)
NTFY_URL="https://ntfy.sh"
NTFY_TOPIC=""
NTFY_TOKEN=""
